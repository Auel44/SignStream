{
  "name": "signstream-extension",
  "version": "0.1.0",
  "description": "SignStream — one-way real-time audio-to-sign-language browser extension (ASL / BSL / GhSL)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "vrm-check": "vite --config vite.harness.config.ts",
    "vrm-check:types": "tsc --noEmit -p tsconfig.harness.json"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-web-extension": "^4.4.3"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "uuid": "^14.0.1",
    "shell-quote": "^1.8.4"
  }
}
