{
  "manifest_version": 3,
  "name": "SignStream",
  "version": "0.1.0",
  "description": "Real-time one-way audio-to-sign-language interpretation for streaming media (ASL / BSL / GhSL).",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen",
    "scripting"
  ],
  "action": {
    "default_title": "SignStream",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "avatar-vrm1.vrm",
        "CoolAlien.vrm",
        "CoolBanana.vrm",
        "Crimsom.vrm",
        "EggBOY.vrm",
        "Erika.vrm",
        "Ferk.vrm",
        "HorrorNurse.vrm",
        "Jennifer.vrm",
        "Pumpkin.vrm",
        "Skull.vrm",
        "Zombie.vrm",
        "src/offscreen/pcm-worklet.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
